# ── Alpaca Markets ─────────────────────────────────────────────────────────────
# Paper trading (safe default)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Anthropic / Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ── Ollama / Gemma 4 (local) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── FRED macroeconomic data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# ── System / Trading mode ──────────────────────────────────────────────────────
# TRADING_MODE must be set to "live" explicitly to enable real money execution
TRADING_MODE=paper
DB_PATH=trading/data/trading_state.db
LOG_PATH=trading/logs

# ── Risk parameters ────────────────────────────────────────────────────────────
MAX_PORTFOLIO_RISK_PCT=0.02       # 2% of portfolio risked per trade
MAX_DRAWDOWN_PCT=0.10             # halt all new trades if drawdown > 10%
POSITION_SIZE_PCT=0.05            # max 5% of portfolio per position
MAX_DAILY_LOSS_USD=500            # hard daily loss limit (applies in live mode)

# ── Scheduling ─────────────────────────────────────────────────────────────────
REBALANCE_INTERVAL_MINUTES=30

# ── Live mode safety (only relevant when TRADING_MODE=live) ───────────────────
REQUIRE_CONFIRMATION=true         # CLI approval required for each order (week 1)
LIVE_POSITION_SCALE=0.25          # start at 25% of max position size in live

# ── Alerts (optional) ─────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
